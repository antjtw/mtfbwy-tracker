# Codes (comma-separated lists allowed for player codes)
PLAYER_CODES=123456
GM_CODE=654321

# Random string, used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me

# Supabase (leave blank to use the local JSON fallback store in dev)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets the GM "Database updates" button apply new SQL migrations by itself.
# Supabase > Project Settings > Database > Connection string > URI (use the Session pooler one). Keep it in Vercel env vars only.
DATABASE_URL=
